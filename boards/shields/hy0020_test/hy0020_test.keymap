#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        test_layer {
            /* A-Z, 0-9, arrows, Enter and Space: all 42 positions are used. */
            bindings = <
                &kp A     &kp B     &kp C     &kp D     &kp E     &kp F     &kp G
                &kp H     &kp I     &kp J     &kp K     &kp L     &kp M     &kp N
                &kp O     &kp P     &kp Q     &kp R     &kp S     &kp T     &kp U
                &kp V     &kp W     &kp X     &kp Y     &kp Z     &kp N0    &kp N1
                &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8
                &kp N9    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp ENTER &kp SPACE
            >;
        };
    };
};
